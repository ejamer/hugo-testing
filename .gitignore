# ======= FENB-1 =======
# Hugo Build Output
fenb-1/public/
# Hugo Cache and Generated Assets
fenb-1/resources/_gen/
fenb-1/.hugo_build.lock
fenb-1/hugo_stats.json
# Local Environment / Tooling
# OS folder clutter (macOS Finder / Windows Explorer) — any folder, so it can't be
# committed into fenb-1/static/ and published with the site
.DS_Store
Thumbs.db
fenb-1/dist/
fenb-1/bin/
# Editor temporary files (optional but recommended)
*.swp
*~
# ^^^^^^^ FENB-1 ^^^^^^^

# Script output and browser session data (generated, not committed)
scripts/output/
scripts/.browser-profile/
__pycache__/

# Editor/IDE
# .idea/
# .vscode/

# Claude Code runtime/local files — keep only commands and shared settings
.claude/*
!.claude/commands
!.claude/settings.json

# Resource folder, used to store sources and assets for content generation, not meant to be committed
resources/

# Node / Playwright — browser-driven verification tooling (package.json IS
# committed; only the installed packages are ignored)
node_modules/
